{"nodes": [{"id": "evaluation_quality_report", "label": "AccessPOSH Quality Evaluation Report", "file_type": "document", "source_file": "AccessPOSH/EVALUATION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "evaluation_shouldprocess_pattern", "label": "ShouldProcess / WhatIf Pattern", "file_type": "rationale", "source_file": "AccessPOSH/EVALUATION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ConfirmImpact='Medium' chosen because default $ConfirmPreference is 'High'. Since Medium < High, no automatic prompts occur in agent sessions. Agents retain full -WhatIf support for dry-runs and can pass -Confirm explicitly for interactive safety checks."}, {"id": "evaluation_parameter_validation_design", "label": "Parameter Validation Design Decision", "file_type": "rationale", "source_file": "AccessPOSH/EVALUATION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "[Parameter(Mandatory)] is deliberately avoided because it causes PowerShell to block and interactively prompt the user, hanging agent automation sessions indefinitely. Manual guards with throw provide immediate terminating errors agents can catch. ValidateNotNullOrEmpty is added as belt-and-suspenders without triggering interactive prompts."}, {"id": "evaluation_error_handling", "label": "ThrowTerminatingError Pattern", "file_type": "rationale", "source_file": "AccessPOSH/EVALUATION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All 'throw string' replaced with $PSCmdlet.ThrowTerminatingError() with ErrorRecord objects in 4 core files (117 replacements). Preserves ErrorCategory, TargetObject, and proper InvocationInfo for downstream error handling."}, {"id": "evaluation_com_disposal", "label": "COM Object Disposal Pattern", "file_type": "rationale", "source_file": "AccessPOSH/EVALUATION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ReleaseComObject added for all major DAO objects ($db, $rs, $rel, $td, $fld) across the three most SQL-intensive files to prevent COM reference leaks."}, {"id": "evaluation_session_singleton", "label": "Session Singleton Pattern", "file_type": "rationale", "source_file": "AccessPOSH/EVALUATION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single $script:AccessSession object manages the COM application instance, database path, and caches. Limits concurrency to one database at a time but simplifies state management for agent automation."}], "edges": [{"source": "evaluation_quality_report", "target": "readme_accessposh_module", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AccessPOSH/EVALUATION.md", "source_location": null, "weight": 1.0}, {"source": "evaluation_shouldprocess_pattern", "target": "databaseops", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AccessPOSH/EVALUATION.md", "source_location": null, "weight": 1.0}, {"source": "evaluation_shouldprocess_pattern", "target": "tableops", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AccessPOSH/EVALUATION.md", "source_location": null, "weight": 1.0}, {"source": "evaluation_shouldprocess_pattern", "target": "metadataops", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AccessPOSH/EVALUATION.md", "source_location": null, "weight": 1.0}, {"source": "evaluation_parameter_validation_design", "target": "readme_accessposh_module", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AccessPOSH/EVALUATION.md", "source_location": null, "w