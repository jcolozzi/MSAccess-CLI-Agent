{
  "nodes": [
    {
      "id": "readme_msaccess_cli_agent",
      "label": "MSAccess-CLI-Agent Project",
      "file_type": "document",
      "source_file": "README.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "VS Code agent powered by GitHub Copilot Chat that translates plain English into PowerShell commands manipulating Access databases live via COM. No MCP server, no Python, no extra processes — pure PowerShell 5.1+ on Windows."
    },
    {
      "id": "readme_accessposh_module",
      "label": "AccessPOSH PowerShell Module",
      "file_type": "document",
      "source_file": "README.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "PowerShell port of unmateria/MCP-Access expanded to 93 public functions covering databases, tables, forms, controls, VBA/VBE, SQL, reports, imports, security, and UI automation. Runs directly in the VS Code integrated terminal via COM."
    },
    {
      "id": "readme_mcp_access_origin",
      "label": "MCP-Access Origin (unmateria)",
      "file_type": "document",
      "source_file": "README.md",
