      "contributor": null
    },
    {
      "id": "readme_com_automation_pattern",
      "label": "COM Automation Architecture",
      "file_type": "rationale",
      "source_file": "README.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "No separate server — the module runs directly in the VS Code integrated terminal. No Python/Node — pure PowerShell 5.1+. Full COM access via DAO/Access Object Model — everything you can do from VBA, you can do from the agent."
    },
    {
      "id": "evaluation_quality_report",
      "label": "AccessPOSH Quality Evaluation Report",
      "file_type": "document",
      "source_file": "AccessPOSH/EVALUATION.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
