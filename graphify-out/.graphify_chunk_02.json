    {
      "id": "pattern_ws_normalized_patching",
      "label": "Whitespace-Normalized Patch Matching",
      "file_type": "rationale",
      "source_file": "AccessPOSH/Public/VbeOps.ps1",
      "source_location": "Update-AccessVbeProc",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Three-layer matching strategy: (1) exact string match, (2) whitespace-normalized fallback via Test-WsNormalizedMatch, (3) context error reporting via Get-ClosestMatchContext. This handles VBA editor reformatting and indentation drift without silently applying wrong patches."
    },
    {
      "id": "pattern_printwindow_capture",
      "label": "PrintWindow Screenshot Capture",
      "file_type": "rationale",
      "source_file": "AccessPOSH/Public/UIAutomation.ps1",
      "source_location": "Get-AccessScreenshot",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Uses Win32 PrintWindow with PW_RENDERFULLCONTENT flag for reliable off-screen capture of Access windows, rather than BitBlt screen capture which fails for minimized/occluded windows. Optional MaxWidth resize prevents oversized images."
    },
    {
      "id": "pattern_vbe_code_caching",
      "label": "VBE Code Caching Strategy",
      "file_type": "rationale",
      "source_file": "AccessPOSH/Public/VbeOps.ps1",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "VBE CodeModule reads are cached per object_type:object_name key in AccessSession.VbeCodeCache and AccessSession.CmCache. All mutation operations (Set-AccessVbeLine, Set-AccessVbeProc, Update-AccessVbeProc, Add-AccessVbeCode) explicitly invalidate both caches after writes to prevent stale reads."
    }
